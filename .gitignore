# Данные и результаты: в репозиторий не кладутся.
# upstream/ — коннектом и апстримный бенчмарк, около четырёх гигабайт;
# cache/ — то, что собирается само при первом запуске;
# out/ — научные прогоны, они принадлежат машине, а не истории кода;
# .venv/ — окружение, его версии зафиксированы отдельно в requirements.lock.
.venv/
upstream/
cache/
out/

# Собранные exe: воспроизводятся из launcher/build.py за двадцать секунд.
release/

# Снимки и отчёты проб: пересобираются прогоном самих проб.
lab/probe/*.png
lab/probe/*.json

# Прочее
__pycache__/
*.pyc
*.pyo
MUJOCO_LOG.TXT
imgui.ini
*.ini
