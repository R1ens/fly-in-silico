# Данные и результаты: в репозиторий не кладутся.
# upstream/ — коннектом и апстримный бенчмарк, около четырёх гигабайт;
# cache/ — то, что собирается само при первом запуске;
# out/ — научные прогоны, они принадлежат машине, а не истории кода;
# .venv/ — окружение, его версии зафиксированы отдельно в requirements.lock.
.venv/
upstream/
cache/
out/

# Собранные exe: воспроизводятся из launcher/build.py за двадцать секунд.
release/

# Снимки и отчёты проб: пересобираются прогоном самих проб.
lab/probe/*.png
lab/probe/*.json
# Промежуточные массивы проб: кадры и сетчатки весят мегабайты и
# пересобираются той же пробой. Два массива-входа (eye_mask, live_raw)
# в истории есть и остаются — они не пересобираются.
lab/probe/vision_gl_*.npy
lab/probe/_grad_ref_out/

# Прочее
__pycache__/
*.pyc
*.pyo
MUJOCO_LOG.TXT
imgui.ini
*.ini

# Рабочие деревья субагентов: это отдельные чекауты, им не место
# в истории этого.
.claude/worktrees/

# Каталоги вывода проб: создаются самими пробами через FLYBRAIN_OUT,
# чтобы не писать в out/ с научными прогонами.
_out/
lab/probe/_*_out/
